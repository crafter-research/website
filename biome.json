{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"README.md",
			"astro.config.mjs",
			"package.json",
			"tsconfig.json",
			"src/**",
			"public/**",
			"!dist",
			"!.astro",
			"!.vercel",
			"!node_modules"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	}
}
