---
import PostList from "../../components/PostList.astro";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { getEntriesWithFallback } from "../../lib/collections";

const lang = "en";
const t = useTranslations(lang);
const entries = await getEntriesWithFallback("research", lang);
---

<Layout
	title={`${t("research.title")} · Crafter Research`}
	description={t("research.description")}
	lang={lang}
	ogImage="/og/research-en.png"
>
	<PostList type="research" lang={lang} entries={entries} />
</Layout>
