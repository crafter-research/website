---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("research"))
	.filter((p) => p.data.lang === "en")
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
	d.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
---

<Layout
  title="Research Log · Crafter Research"
  description="Milestones from the lab, written as we go. Hypotheses, measurements, and the conclusions that moved."
  lang="en"
>
  <main class="research-log-index">
    <nav class="article-nav">
      <a href="/">Crafter Research</a>
      <a href="/es/research">Español</a>
    </nav>

    <header class="research-log-header">
      <p class="section-label">Crafter Research / Research log</p>
      <h1>Research Log</h1>
      <p>
        Milestones from the lab, written as we go. Hypotheses, measurements, and the conclusions that moved.
      </p>
    </header>

    <section class="research-log-feed" aria-label="Research log entries">
      {
        posts.map((post) => (
          <a
            href={`/research/${post.data.urlSlug}`}
            class="note-row"
          >
            <div>
              <strong>{post.data.title}</strong>
              <span>{post.data.status} / {fmtDate(post.data.date)} / {post.data.project}</span>
            </div>
            <p>{post.data.description}</p>
          </a>
        ))
      }
    </section>

    <footer class="article-footer">
      <a href="/">Back to lab</a>
    </footer>
  </main>
</Layout>
