---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("research"))
  .filter((p) => p.data.lang === "en")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<Layout
  title="Research Log · Crafter Research"
  description="Milestones from the lab, written as we go. Hypotheses, measurements, and the conclusions that moved."
  lang="en"
>
  <main class="mx-auto max-w-5xl px-5 py-10 sm:px-8 lg:px-10">
    <header class="rounded-lg border border-(--color-border) bg-(--color-panel) p-6 sm:p-10">
      <p class="text-(--color-muted) mb-8 font-mono text-sm tracking-widest uppercase">
        <a href="/" class="hover:text-(--color-text) transition-colors">crafter research</a> / research log
      </p>
      <h1 class="max-w-3xl text-5xl font-semibold leading-[1.02] text-(--color-text) sm:text-6xl">
        Research Log
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-(--color-muted-strong)">
        Milestones from the lab, written as we go. Hypotheses, measurements, and the conclusions that moved.
      </p>
    </header>

    <section class="mt-8 grid gap-4">
      {
        posts.map((post) => (
          <a
            href={`/research/${post.data.urlSlug}`}
            class="log-card"
          >
            <div class="mb-4 flex flex-wrap items-center gap-3">
              <span class="pill">
                {post.data.status}
              </span>
              <span class="text-(--color-muted) font-mono text-xs">
                {fmtDate(post.data.date)} / {post.data.project}
              </span>
            </div>
            <h2 class="text-2xl font-semibold leading-tight text-(--color-text)">{post.data.title}</h2>
            <p class="text-(--color-muted-strong) mt-3 text-sm leading-6">{post.data.description}</p>
          </a>
        ))
      }
    </section>

    <footer class="border-(--color-border) text-(--color-muted) mt-20 border-t pt-8 text-sm">
      <a href="/" class="hover:text-(--color-text) transition-colors">Back to lab</a>
    </footer>
  </main>
</Layout>
