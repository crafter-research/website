---
import PostArticle from "../../components/PostArticle.astro";
import Layout from "../../layouts/Layout.astro";
import {
	getEntryNeighbors,
	getEntryWithFallback,
	getSlugs,
} from "../../lib/collections";

export async function getStaticPaths() {
	const slugs = await getSlugs("research");
	return slugs.map((slug) => ({ params: { slug } }));
}

const lang = "en";
const { slug } = Astro.params;
const resolved = await getEntryWithFallback("research", lang, slug!);
if (!resolved) return Astro.redirect("/research");
const { prev, next } = await getEntryNeighbors("research", lang, slug!);
---

<Layout
	title={`${resolved.entry.data.title} · Crafter Research`}
	description={resolved.entry.data.description}
	lang={lang}
>
	<PostArticle type="research" lang={lang} resolved={resolved} prev={prev} next={next} />
</Layout>
