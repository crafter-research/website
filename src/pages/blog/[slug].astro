---
import PostArticle from "../../components/PostArticle.astro";
import Layout from "../../layouts/Layout.astro";
import { getEntryWithFallback, getSlugs } from "../../lib/collections";

export async function getStaticPaths() {
	const slugs = await getSlugs("blog");
	return slugs.map((slug) => ({ params: { slug } }));
}

const lang = "en";
const { slug } = Astro.params;
const resolved = await getEntryWithFallback("blog", lang, slug!);
if (!resolved) return Astro.redirect("/blog");
---

<Layout
	title={`${resolved.entry.data.title} · Crafter Research`}
	description={resolved.entry.data.description}
	lang={lang}
>
	<PostArticle type="blog" lang={lang} resolved={resolved} />
</Layout>
