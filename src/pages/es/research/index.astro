---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

const posts = (await getCollection("research"))
	.filter((p) => p.data.lang === "es")
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
	d.toLocaleDateString("es-PE", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
---

<Layout
  title="Registro de Investigación · Crafter Research"
  description="Hitos del laboratorio, escritos sobre la marcha. Hipótesis, mediciones, y las conclusiones que se movieron."
  lang="es"
>
  <main class="research-log-index">
    <nav class="article-nav">
      <a href="/es">Crafter Research</a>
      <a href="/research">English</a>
    </nav>

    <header class="research-log-header">
      <p class="section-label">Crafter Research / Registro</p>
      <h1>Registro de Investigación</h1>
      <p>
        Hitos del laboratorio, escritos sobre la marcha. Hipótesis, mediciones, y las conclusiones que se movieron.
      </p>
    </header>

    <section class="research-log-feed" aria-label="Entradas del registro">
      {
        posts.map((post) => (
          <a
            href={`/es/research/${post.data.urlSlug}`}
            class="note-row"
          >
            <div>
              <strong>{post.data.title}</strong>
              <span>{post.data.status} / {fmtDate(post.data.date)} / {post.data.project}</span>
            </div>
            <p>{post.data.description}</p>
          </a>
        ))
      }
    </section>

    <footer class="article-footer">
      <a href="/es">Volver al lab</a>
    </footer>
  </main>
</Layout>
