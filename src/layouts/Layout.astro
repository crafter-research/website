---
import "../styles/global.css";
import EdgePatterns from "../components/EdgePatterns.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { siteJsonLd } from "../lib/seo";

interface Props {
	title: string;
	description: string;
	lang?: Lang;
	ogImage?: string;
	keywords?: string[];
	article?: {
		publishedTime: Date;
		author: string;
		tags: string[];
	};
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description,
	lang = "en",
	ogImage,
	keywords = [],
	article,
	jsonLd = [],
} = Astro.props;
const t = useTranslations(lang);
const siteURL = Astro.site ?? new URL("https://crafter.ing");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(
	ogImage ?? `/og/home-${lang === "es" ? "es" : "en"}.png`,
	siteURL,
);
const ogLocales: Record<Lang, string> = {
	en: "en_US",
	es: "es_PE",
	pt: "pt_BR",
	zh: "zh_CN",
};
const altLangs: Lang[] = ["en", "es", "pt", "zh"];
const basePath = Astro.url.pathname.replace(/^\/(es|pt|zh)(?=\/|$)/, "") || "/";
const alternates = altLangs.map((code) => ({
	code,
	href: new URL(
		code === "en" ? basePath : `/${code}${basePath === "/" ? "" : basePath}`,
		siteURL,
	).href,
}));
---

<html lang={lang}>
	<head>
		<meta charset="utf-8">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="icon" href="/favicon.ico" sizes="48x48">
		<meta name="viewport" content="width=device-width">
		<meta name="description" content={description}>
		<link rel="canonical" href={canonicalURL.href}>
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href}>)}
		<link rel="alternate" hreflang="x-default" href={alternates[0].href}>
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")}>}
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonicalURL.href}>
		<meta property="og:site_name" content="Crafter Research">
		<meta property="og:locale" content={ogLocales[lang]}>
		<meta property="og:type" content={article ? "article" : "website"}>
		{article && <meta property="article:published_time" content={article.publishedTime.toISOString()}>}
		{article && <meta property="article:author" content={article.author}>}
		{article?.tags.map((tag) => <meta property="article:tag" content={tag}>)}
		{article && <meta name="author" content={article.author}>}
		{[siteJsonLd, ...jsonLd].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
		<meta property="og:image" content={ogImageURL.href}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImageURL.href}>
		<meta name="generator" content={Astro.generator}>
		<script is:inline>
		try {
			const theme = localStorage.getItem("cr-research-theme");
			if (theme === "light" || theme === "dark") {
				document.documentElement.dataset.theme = theme;
			}
		} catch {}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		>
		<title>{title}</title>
	</head>
	<body class="bg-(--color-bg) text-(--color-text) font-sans antialiased">
		<a class="skip-link" href="#main-content">{t("skip.content")}</a>
		<EdgePatterns />
		<SiteHeader lang={lang} />
		<div id="main-content" tabindex="-1"><slot /></div>
		<SiteFooter lang={lang} />
	</body>
</html>
