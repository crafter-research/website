---
import type { ProjectLocale } from "../data/projects";
import type { Lang } from "../i18n/ui";
import { useTranslatedPath } from "../i18n/utils";
import Layout from "../layouts/Layout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const cl: ProjectLocale = lang === "es" ? "es" : "en";
const tp = useTranslatedPath(lang);
const inbox = "railly@crafterstation.com";

const copy = {
	en: {
		meta: "Support the lab · Crafter Research",
		description:
			"Support Crafter Research with compute and model credits, data access, or domain expertise. Every result comes back public, with its oracle.",
		kicker: "Crafter Research · Support",
		title: "Help us run the next experiment.",
		body: "We are a small lab. Each thing we ask for is tied to a specific belief on the frontier map, and everything it produces comes back public: the claim, its oracle, the traces, and the people who signed it.",
		cta: "Write to us",
		mapCta: "See what it would fund",
		asks: [
			[
				"Compute and model credits",
				"Agent fleets run on model APIs and modest cloud machines. Credits go to one belief at a time, and the run log shows where every token went.",
			],
			[
				"Data and access",
				"Continuous seismic waveforms, health and procurement releases, archive scans, khipu photographs. Access that turns a catalogued problem into an experiment.",
			],
			[
				"Domain experts",
				"Seismologists, epidemiologists, archaeologists, cryptographers, political scientists. The person who signs a claim is part of the protocol, not a reviewer at the end.",
			],
		],
		returnTitle: "What comes back",
		returns: [
			"A public result for every run, including the ones that fail.",
			"Credit on the claim, the release, and the paper.",
			"No exclusivity. Data, code, and traces stay open.",
		],
	},
	es: {
		meta: "Apoyar al lab · Crafter Research",
		description:
			"Apoya a Crafter Research con cómputo y créditos de modelos, acceso a datos o experiencia de dominio. Cada resultado vuelve público, con su oráculo.",
		kicker: "Crafter Research · Apoyar",
		title: "Ayúdanos a correr el próximo experimento.",
		body: "Somos un lab pequeño. Cada cosa que pedimos está atada a una creencia concreta del mapa del frontier, y todo lo que produce vuelve público: el claim, su oráculo, los traces y las personas que lo firmaron.",
		cta: "Escríbenos",
		mapCta: "Ver qué financiaría",
		asks: [
			[
				"Cómputo y créditos de modelos",
				"Las flotas de agentes corren sobre APIs de modelos y máquinas cloud modestas. Los créditos van a una creencia a la vez, y el log muestra a dónde fue cada token.",
			],
			[
				"Datos y acceso",
				"Ondas sísmicas continuas, publicaciones de salud y contrataciones, escaneos de archivo, fotografías de khipus. Acceso que convierte un problema catalogado en un experimento.",
			],
			[
				"Expertos de dominio",
				"Sismólogos, epidemiólogos, arqueólogos, criptógrafos, politólogos. Quien firma un claim es parte del protocolo, no un revisor al final.",
			],
		],
		returnTitle: "Qué vuelve",
		returns: [
			"Un resultado público por cada corrida, incluidas las que fallan.",
			"Crédito en el claim, el release y el paper.",
			"Sin exclusividad. Datos, código y traces quedan abiertos.",
		],
	},
}[cl];
---

<Layout title={copy.meta} description={copy.description} lang={cl}>
	<main class="sp">
		<header class="sp-hero">
			<p class="sp-kicker">{copy.kicker}</p>
			<h1>{copy.title}</h1>
			<p class="sp-lede">{copy.body}</p>
			<div class="sp-ctas">
				<a class="sp-btn sp-btn-primary" href={`mailto:${inbox}`}
					>{copy.cta} <span aria-hidden="true">→</span></a
				>
				<a class="sp-btn" href={tp("/frontier")}>{copy.mapCta}</a>
			</div>
		</header>

		<ol class="sp-asks">
			{copy.asks.map(([title, body], i) => (
					<li>
						<span>{String(i + 1).padStart(2, "0")}</span>
						<strong>{title}</strong>
						<p>{body}</p>
					</li>
				))}
		</ol>

		<section class="sp-return">
			<h2>{copy.returnTitle}</h2>
			<ul>
				{copy.returns.map((line) => <li>{line}</li>)}
			</ul>
			<p class="sp-mail"><a href={`mailto:${inbox}`}>{inbox}</a></p>
		</section>
	</main>
</Layout>

<style>
.sp {
	margin: 0 auto;
	max-width: 72rem;
	padding: calc(var(--header-height) + 4rem) var(--layout-padding) 6rem;
}
.sp-kicker {
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.72rem;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}
.sp-hero h1 {
	font-size: clamp(2.2rem, 5vw, 3.8rem);
	font-weight: 600;
	letter-spacing: -0.03em;
	line-height: 1.05;
	margin: 1rem 0 1.25rem;
	max-width: 16ch;
}
.sp-lede {
	color: var(--color-muted-strong);
	font-size: 1.08rem;
	line-height: 1.6;
	max-width: 42rem;
}
.sp-ctas {
	display: flex;
	flex-wrap: wrap;
	gap: 0.75rem;
	margin-top: 2rem;
}
.sp-btn {
	border: 1px solid var(--color-border);
	border-radius: 999px;
	font-size: 0.92rem;
	padding: 0.6rem 1.1rem;
	transition: border-color 0.15s ease;
}
.sp-btn:hover {
	border-color: var(--color-accent);
}
.sp-btn span {
	display: inline-block;
	transition: transform 0.2s ease;
}
.sp-btn:hover span {
	transform: translateX(3px);
}
.sp-btn-primary {
	background: var(--color-text);
	border-color: var(--color-text);
	color: var(--color-bg);
}
.sp-asks {
	border: 1px solid var(--color-border);
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	margin: 4rem 0;
}
.sp-asks li {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
	padding: 1.5rem;
	transition: background 0.2s ease;
}
.sp-asks li + li {
	border-left: 1px solid var(--color-border);
}
.sp-asks li:hover {
	background: var(--color-panel);
}
.sp-asks span {
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.75rem;
}
.sp-asks strong {
	font-size: 1.1rem;
	font-weight: 600;
}
.sp-asks p {
	color: var(--color-muted-strong);
	font-size: 0.92rem;
	line-height: 1.55;
}
.sp-return {
	max-width: 42rem;
}
.sp-return h2 {
	font-size: 1.35rem;
	font-weight: 600;
	margin-bottom: 1rem;
}
.sp-return li {
	border-bottom: 1px solid var(--color-border);
	color: var(--color-muted-strong);
	padding: 0.75rem 0;
}
.sp-mail {
	font-family: var(--font-mono);
	font-size: 0.9rem;
	margin-top: 1.5rem;
}
.sp-mail a {
	color: var(--color-accent);
}
@media (max-width: 760px) {
	.sp-asks {
		grid-template-columns: 1fr;
	}
	.sp-asks li + li {
		border-left: 0;
		border-top: 1px solid var(--color-border);
	}
}
</style>
