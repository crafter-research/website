---
import type { Lang } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const contentLang = lang === "es" ? "es" : "en";
const atlas = "https://muniscan.crafter.ing";
const repo = "https://github.com/crafter-research/muniscan";
const snapshot = `${repo}/tree/main/data/2026-08-21`;

const copy = {
	en: {
		metaTitle: "Muniscan research log · Crafter Research",
		metaDescription:
			"The decisions, failures, evidence, and next questions behind Muniscan, Crafter Research's recurring census of Peru's municipal digital surface.",
		label: "Research log / Muniscan",
		title: "How a one-shot census became a recurring public instrument.",
		deck: "This is the working record behind Muniscan: what we asked, what failed, what changed, and what the evidence still cannot support. The live atlas has the explorer. This page keeps the reasoning trail.",
		openAtlas: "Open live atlas",
		openCode: "Inspect source",
		stateLabel: "Current state",
		state:
			"Two comparable snapshots are public. Recurrence has been demonstrated once without bypassing the completeness gate.",
		questionLabel: "Research question",
		question:
			"Can the public links declared by every Peruvian municipality become a repeatable, inspectable map of technical architecture without turning a heuristic score into a claim about institutional quality?",
		principles: [
			[
				"Preserve the universe",
				"A weak directory response cannot silently erase municipalities already present in a published census.",
			],
			[
				"Fail before publishing",
				"Incomplete runs stop at the gate. A smaller dataset is not automatically a new reality.",
			],
			[
				"Name the boundary",
				"The index describes visible links and hostname classifications, not ownership, uptime, service quality, security, or compliance.",
			],
		],
		logLabel: "Field log",
		logTitle: "The useful part is where the system resisted.",
		entries: [
			{
				date: "2026-08-08",
				code: "01",
				title: "First national snapshot",
				body: "The first run published 1,794 scored municipalities, the method, limitations, and raw artifacts. It proved census-scale collection, but not recurrence.",
				proof: "1,794 scored records",
				href: `${repo}/tree/main/data/2026-08-08`,
			},
			{
				date: "2026-08-09",
				code: "02",
				title: "The next scans failed safely",
				body: "gob.pe discovery returned sharply smaller municipal sets. The completeness gate rejected publication. That failure exposed the real problem: current discovery could not be the sole memory of the municipal universe.",
				proof: "publication blocked",
				href: `${repo}/issues/1`,
			},
			{
				date: "2026-08-20",
				code: "03",
				title: "Recurrence became a stateful protocol",
				body: "Discovery was changed to union the current directory with the latest published census. Restored municipalities are fetched again, and non-2xx responses remain explicit errors instead of disappearing.",
				proof: "repair merged",
				href: `${repo}/pull/2`,
			},
			{
				date: "2026-08-21",
				code: "04",
				title: "Second snapshot and bounded HTTP sample",
				body: "The repaired pipeline published 1,871 scored municipalities, an explicit diff, and one stratified 100-domain HTTP observation. This demonstrates one recurrence, not a stable trend or uptime history.",
				proof: "1,871 · +78 · −1",
				href: snapshot,
			},
			{
				date: "2026-08-21",
				code: "05",
				title: "The instrument got its own public surface",
				body: "The data explorer moved to a dedicated domain and visual identity. Crafter Research now keeps this reasoning log separately so the public result and the process that produced it do not collapse into one page.",
				proof: "atlas live",
				href: atlas,
			},
		],
		changeLabel: "What changed",
		changeTitle: "One recurrence changed the claim we can make.",
		before: "Before",
		after: "Now",
		beforeText:
			"We had a useful national dataset and an unproven promise that it could recur.",
		afterText:
			"We have two comparable snapshots and evidence that the repaired pipeline can publish again under its own guardrails.",
		notYet: "Not yet",
		notYetText:
			"We do not have enough history to claim a trend, operating reliability, institutional improvement, or service availability.",
		nextLabel: "Next questions",
		nextTitle: "What would make the next snapshot more valuable?",
		next: [
			"Run enough complete cycles to distinguish recurring operation from one successful rerun.",
			"Add source-freshness and accessibility observations without folding them into a misleading master score.",
			"Create correction and right-of-reply workflows that preserve both the original observation and the response.",
			"Test whether the hostname classifier can reduce false negatives without reviving known ownership false positives.",
		],
		artifactsLabel: "Primary artifacts",
		artifacts: [
			["Live atlas", "Search the full census", atlas],
			["Latest snapshot", "Frozen 21 August run", snapshot],
			["Method", "Discovery, score, and guards", `${repo}/blob/main/METHOD.md`],
			[
				"Limitations",
				"Claims this evidence cannot support",
				`${repo}/blob/main/LIMITATIONS.md`,
			],
		],
		fallback:
			"This research log is shown in English while a full translation for this locale is prepared.",
	},
	es: {
		metaTitle: "Bitácora de Muniscan · Crafter Research",
		metaDescription:
			"Decisiones, fallas, evidencia y próximas preguntas detrás de Muniscan, el censo recurrente de la superficie digital municipal del Perú.",
		label: "Bitácora de investigación / Muniscan",
		title:
			"Cómo un censo puntual se convirtió en un instrumento público recurrente.",
		deck: "Este es el registro de trabajo detrás de Muniscan: qué preguntamos, qué falló, qué cambió y qué todavía no permite afirmar la evidencia. El atlas tiene el explorador. Esta página conserva el razonamiento.",
		openAtlas: "Abrir atlas en vivo",
		openCode: "Inspeccionar código",
		stateLabel: "Estado actual",
		state:
			"Hay dos snapshots comparables y públicos. La recurrencia se demostró una vez sin saltarse el control de completitud.",
		questionLabel: "Pregunta de investigación",
		question:
			"¿Podemos convertir los enlaces públicos declarados por cada municipalidad peruana en un mapa repetible e inspeccionable de arquitectura técnica sin confundir un score heurístico con calidad institucional?",
		principles: [
			[
				"Preservar el universo",
				"Una respuesta débil del directorio no puede borrar silenciosamente municipalidades de un censo ya publicado.",
			],
			[
				"Fallar antes de publicar",
				"Las corridas incompletas se detienen. Un dataset menor no se convierte automáticamente en una nueva realidad.",
			],
			[
				"Nombrar el límite",
				"El índice describe enlaces visibles y clasificaciones por hostname, no propiedad, uptime, calidad, seguridad ni cumplimiento.",
			],
		],
		logLabel: "Registro de campo",
		logTitle: "La parte útil está donde el sistema se resistió.",
		entries: [
			{
				date: "2026-08-08",
				code: "01",
				title: "Primer snapshot nacional",
				body: "La primera corrida publicó 1,794 municipalidades puntuadas, método, límites y artefactos crudos. Probó recolección censal, no recurrencia.",
				proof: "1,794 registros",
				href: `${repo}/tree/main/data/2026-08-08`,
			},
			{
				date: "2026-08-09",
				code: "02",
				title: "Las siguientes corridas fallaron de forma segura",
				body: "El descubrimiento de gob.pe devolvió conjuntos mucho menores. El control de completitud bloqueó la publicación. La falla reveló el problema real: el descubrimiento actual no podía ser la única memoria del universo municipal.",
				proof: "publicación bloqueada",
				href: `${repo}/issues/1`,
			},
			{
				date: "2026-08-20",
				code: "03",
				title: "La recurrencia se volvió un protocolo con memoria",
				body: "El descubrimiento pasó a unir el directorio actual con el último censo publicado. Las municipalidades recuperadas se consultan otra vez y los non-2xx quedan como errores explícitos en vez de desaparecer.",
				proof: "reparación mergeada",
				href: `${repo}/pull/2`,
			},
			{
				date: "2026-08-21",
				code: "04",
				title: "Segundo snapshot y muestra HTTP acotada",
				body: "El pipeline reparado publicó 1,871 municipalidades puntuadas, un diff explícito y una observación HTTP estratificada de 100 dominios. Esto demuestra una recurrencia, no una tendencia estable ni historial de uptime.",
				proof: "1,871 · +78 · −1",
				href: snapshot,
			},
			{
				date: "2026-08-21",
				code: "05",
				title: "El instrumento obtuvo su propia superficie pública",
				body: "El explorador de datos se movió a un dominio e identidad visual propios. Crafter Research conserva esta bitácora por separado para no colapsar el resultado y el proceso que lo produjo en una sola página.",
				proof: "atlas en vivo",
				href: atlas,
			},
		],
		changeLabel: "Qué cambió",
		changeTitle: "Una recurrencia cambió la afirmación que podemos hacer.",
		before: "Antes",
		after: "Ahora",
		beforeText:
			"Teníamos un dataset nacional útil y una promesa todavía no probada de que podía repetirse.",
		afterText:
			"Tenemos dos snapshots comparables y evidencia de que el pipeline reparado puede publicar otra vez bajo sus propios controles.",
		notYet: "Todavía no",
		notYetText:
			"No tenemos suficiente historia para afirmar tendencia, confiabilidad operativa, mejora institucional o disponibilidad de servicios.",
		nextLabel: "Próximas preguntas",
		nextTitle: "¿Qué haría más valioso el siguiente snapshot?",
		next: [
			"Completar suficientes ciclos para distinguir operación recurrente de una sola repetición exitosa.",
			"Añadir observaciones de frescura y accesibilidad sin convertirlas en un master score engañoso.",
			"Crear flujos de corrección y derecho de respuesta que preserven la observación original y la respuesta.",
			"Probar si el clasificador por hostname puede reducir falsos negativos sin revivir falsos positivos de propiedad.",
		],
		artifactsLabel: "Artefactos primarios",
		artifacts: [
			["Atlas en vivo", "Buscar en todo el censo", atlas],
			["Último snapshot", "Corrida congelada del 21 de agosto", snapshot],
			[
				"Método",
				"Descubrimiento, score y controles",
				`${repo}/blob/main/METHOD.md`,
			],
			[
				"Limitaciones",
				"Afirmaciones que la evidencia no permite",
				`${repo}/blob/main/LIMITATIONS.md`,
			],
		],
		fallback: "",
	},
}[contentLang];
---

<Layout title={copy.metaTitle} description={copy.metaDescription} lang={lang}>
	<main class="research-log">
		<header class="log-hero">
			<div class="log-intro">
				<p class="log-label">{copy.label}</p>
				<h1>{copy.title}</h1>
				<p class="log-deck">{copy.deck}</p>
				{lang !== "en" && lang !== "es" && <small>{copy.fallback}</small>}
				<div class="log-actions">
					<a class="primary" href={atlas}>{copy.openAtlas} ↗</a>
					<a href={repo}>{copy.openCode} ↗</a>
				</div>
			</div>
			<aside class="log-state">
				<span>{copy.stateLabel}</span>
				<strong>02</strong>
				<p>{copy.state}</p>
				<code>snapshot::2026-08-21</code>
			</aside>
		</header>

		<section class="question-block" aria-labelledby="question-title">
			<p class="log-label">{copy.questionLabel}</p>
			<h2 id="question-title">{copy.question}</h2>
			<div class="principle-grid">
				{copy.principles.map(([title, body], index) => (
					<article><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{body}</p></article>
				))}
			</div>
		</section>

		<section class="field-log" aria-labelledby="field-log-title">
			<header>
				<p class="log-label">{copy.logLabel}</p>
				<h2 id="field-log-title">{copy.logTitle}</h2>
			</header>
			<ol>
				{copy.entries.map((entry) => (
					<li>
						<div class="entry-date"><span>{entry.code}</span><time datetime={entry.date}>{entry.date}</time></div>
						<div class="entry-copy"><h3>{entry.title}</h3><p>{entry.body}</p></div>
						<a href={entry.href} target="_blank" rel="noreferrer"><span>{entry.proof}</span>↗</a>
					</li>
				))}
			</ol>
		</section>

		<section class="claim-shift" aria-labelledby="claim-shift-title">
			<header>
				<p class="log-label">{copy.changeLabel}</p>
				<h2 id="claim-shift-title">{copy.changeTitle}</h2>
			</header>
			<div class="claim-grid">
				<article>
					<span>01</span>
					<h3>{copy.before}</h3>
					<p>{copy.beforeText}</p>
				</article>
				<article class="claim-current">
					<span>02</span>
					<h3>{copy.after}</h3>
					<p>{copy.afterText}</p>
				</article>
				<article class="claim-boundary">
					<span>!</span>
					<h3>{copy.notYet}</h3>
					<p>{copy.notYetText}</p>
				</article>
			</div>
		</section>

		<section class="next-block" aria-labelledby="next-title">
			<div>
				<p class="log-label">{copy.nextLabel}</p>
				<h2 id="next-title">{copy.nextTitle}</h2>
			</div>
			<ol>
				{copy.next.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>)}
			</ol>
		</section>

		<footer class="artifact-block">
			<p class="log-label">{copy.artifactsLabel}</p>
			<nav>
				{copy.artifacts.map(([title, detail, href]) => <a href={href} target="_blank" rel="noreferrer"><span><strong>{title}</strong><small>{detail}</small></span><i>↗</i></a>)}
			</nav>
		</footer>
	</main>
</Layout>

<style>
.research-log {
	margin: 0 auto;
	max-width: 92rem;
	padding: 0 clamp(1.25rem, 5vw, 5.5rem) 7rem;
}
.log-label {
	color: var(--color-accent);
	font-family: var(--font-mono);
	font-size: 0.66rem;
	letter-spacing: 0.16em;
	text-transform: uppercase;
}
.log-hero {
	display: grid;
	gap: clamp(3rem, 9vw, 9rem);
	grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.55fr);
	min-height: calc(90svh - var(--header-height));
	padding: clamp(6rem, 11vw, 10rem) 0 6rem;
	align-items: center;
}
.log-intro h1 {
	font-size: clamp(3.3rem, 7.4vw, 7.4rem);
	font-weight: 470;
	letter-spacing: -0.065em;
	line-height: 0.9;
	margin-top: 1.3rem;
	max-width: 11.5ch;
	text-wrap: balance;
}
.log-deck {
	color: var(--color-muted-strong);
	font-size: clamp(1rem, 1.5vw, 1.2rem);
	line-height: 1.7;
	margin-top: 2rem;
	max-width: 46rem;
}
.log-intro > small {
	color: var(--color-muted);
	display: block;
	font-family: var(--font-mono);
	font-size: 0.7rem;
	margin-top: 1rem;
}
.log-actions {
	display: flex;
	flex-wrap: wrap;
	gap: 0.75rem;
	margin-top: 2rem;
}
.log-actions a {
	border: 1px solid var(--color-border);
	color: var(--color-text);
	font-family: var(--font-mono);
	font-size: 0.72rem;
	padding: 0.85rem 1rem;
}
.log-actions .primary {
	background: var(--color-text);
	border-color: var(--color-text);
	color: var(--color-bg);
}
.log-actions a:hover {
	border-color: var(--color-accent);
	color: var(--color-accent);
}
.log-actions .primary:hover {
	background: var(--color-accent);
	color: var(--color-bg);
}
.log-state {
	border: 1px solid var(--color-border);
	display: grid;
	min-height: 25rem;
	padding: 1.5rem;
	position: relative;
}
.log-state::after {
	background: var(--color-accent);
	content: "";
	height: 1px;
	left: 1.5rem;
	position: absolute;
	right: 1.5rem;
	top: 50%;
}
.log-state > span,
.log-state code {
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.65rem;
	text-transform: uppercase;
}
.log-state strong {
	align-self: end;
	font-family: var(--font-mono);
	font-size: clamp(5rem, 10vw, 8rem);
	font-weight: 430;
	letter-spacing: -0.1em;
	line-height: 0.7;
}
.log-state p {
	align-self: end;
	color: var(--color-muted-strong);
	font-size: 0.86rem;
	line-height: 1.6;
	margin-top: 2rem;
}
.log-state code {
	margin-top: 1rem;
}
.question-block,
.field-log,
.claim-shift,
.next-block,
.artifact-block {
	border-top: 1px solid var(--color-border);
	padding: clamp(5rem, 9vw, 8rem) 0;
}
.question-block > h2,
.field-log header h2,
.claim-shift header h2,
.next-block h2 {
	font-size: clamp(2.4rem, 5.2vw, 5rem);
	font-weight: 470;
	letter-spacing: -0.055em;
	line-height: 0.98;
	margin-top: 1rem;
	text-wrap: balance;
}
.question-block > h2 {
	max-width: 19ch;
}
.principle-grid {
	border-bottom: 1px solid var(--color-border);
	border-top: 1px solid var(--color-border);
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	margin-top: clamp(3rem, 7vw, 6rem);
}
.principle-grid article {
	min-height: 17rem;
	padding: 1.2rem;
}
.principle-grid article + article {
	border-left: 1px solid var(--color-border);
}
.principle-grid span,
.entry-date,
.claim-grid span,
.next-block li span {
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.65rem;
}
.principle-grid h3 {
	font-size: 1.15rem;
	margin-top: 4rem;
}
.principle-grid p {
	color: var(--color-muted-strong);
	font-size: 0.82rem;
	line-height: 1.6;
	margin-top: 0.85rem;
}
.field-log > header,
.claim-shift > header {
	display: grid;
	gap: 2rem;
	grid-template-columns: minmax(12rem, 0.5fr) 1fr;
	margin-bottom: 4rem;
}
.field-log header h2,
.claim-shift header h2 {
	margin-top: 0;
	max-width: 13ch;
}
.field-log ol {
	border-top: 1px solid var(--color-border);
	list-style: none;
	margin: 0;
	padding: 0;
}
.field-log li {
	align-items: start;
	border-bottom: 1px solid var(--color-border);
	display: grid;
	gap: 2rem;
	grid-template-columns: 9rem minmax(0, 1fr) 10rem;
	padding: 1.5rem 0;
}
.entry-date {
	display: grid;
	gap: 0.65rem;
}
.entry-date span {
	color: var(--color-accent);
}
.entry-copy h3 {
	font-size: 1.15rem;
	font-weight: 570;
}
.entry-copy p {
	color: var(--color-muted-strong);
	font-size: 0.86rem;
	line-height: 1.65;
	margin-top: 0.6rem;
	max-width: 48rem;
}
.field-log li > a {
	align-items: center;
	border: 1px solid var(--color-border);
	color: var(--color-muted);
	display: flex;
	font-family: var(--font-mono);
	font-size: 0.65rem;
	justify-content: space-between;
	padding: 0.7rem;
}
.field-log li > a:hover {
	border-color: var(--color-accent);
	color: var(--color-accent);
}
.claim-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
}
.claim-grid article {
	border: 1px solid var(--color-border);
	min-height: 20rem;
	padding: 1.5rem;
}
.claim-grid article + article {
	border-left: 0;
}
.claim-grid h3 {
	font-size: 1.5rem;
	font-weight: 520;
	margin-top: 6rem;
}
.claim-grid p {
	color: var(--color-muted-strong);
	line-height: 1.65;
	margin-top: 1rem;
}
.claim-grid .claim-current {
	background: color-mix(in srgb, var(--color-accent) 7%, transparent);
	border-color: var(--color-accent);
}
.claim-grid .claim-boundary {
	border-top-color: var(--color-accent);
}
.claim-boundary > span {
	color: var(--color-accent);
}
.next-block {
	display: grid;
	gap: clamp(3rem, 8vw, 8rem);
	grid-template-columns: minmax(16rem, 0.55fr) 1fr;
}
.next-block ol {
	border-top: 1px solid var(--color-border);
	list-style: none;
	margin: 0;
	padding: 0;
}
.next-block li {
	border-bottom: 1px solid var(--color-border);
	display: grid;
	gap: 1.5rem;
	grid-template-columns: 2rem 1fr;
	padding: 1.2rem 0;
}
.next-block li p {
	color: var(--color-muted-strong);
	line-height: 1.6;
}
.artifact-block nav {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	margin-top: 2rem;
}
.artifact-block a {
	align-items: center;
	border-bottom: 1px solid var(--color-border);
	color: inherit;
	display: flex;
	justify-content: space-between;
	min-height: 6rem;
	padding: 1rem;
}
.artifact-block a:nth-child(odd) {
	border-right: 1px solid var(--color-border);
}
.artifact-block a:hover {
	background: color-mix(in srgb, var(--color-accent) 5%, transparent);
}
.artifact-block a span {
	display: grid;
	gap: 0.35rem;
}
.artifact-block small {
	color: var(--color-muted);
	font-size: 0.72rem;
}
.artifact-block i {
	color: var(--color-accent);
	font-style: normal;
}
@media (max-width: 800px) {
	.log-hero,
	.next-block {
		grid-template-columns: 1fr;
	}
	.log-hero {
		min-height: auto;
		padding-top: 7rem;
	}
	.log-state {
		min-height: 20rem;
	}
	.principle-grid {
		grid-template-columns: 1fr;
	}
	.principle-grid article {
		min-height: auto;
	}
	.principle-grid article + article {
		border-left: 0;
		border-top: 1px solid var(--color-border);
	}
	.principle-grid h3 {
		margin-top: 2.5rem;
	}
	.field-log > header,
	.claim-shift > header {
		grid-template-columns: 1fr;
	}
	.field-log li {
		grid-template-columns: 7rem 1fr;
	}
	.field-log li > a {
		grid-column: 2;
		width: min(100%, 14rem);
	}
	.claim-grid {
		grid-template-columns: 1fr;
	}
	.claim-grid article {
		min-height: auto;
	}
