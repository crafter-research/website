---
import type { Lang } from "../i18n/ui";
import { useTranslatedPath, useTranslations } from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";
import SiteLogo from "./SiteLogo.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

interface Props {
	lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
---

<header
	class="site-header mx-auto flex w-full max-w-[calc(var(--header-width)+(var(--layout-padding)*2))] items-center justify-between px-(--layout-padding)"
>
	<SiteLogo lang={lang} />
	<nav class="site-header-nav" aria-label="Primary navigation">
		<span class="site-header-links">
			<a href={tp("/systems")} class="nav-link nav-link-primary"
				>{t("systems.title")}</a
			>
			<a href={tp("/projects")} class="nav-link nav-link-primary"
				>{t("portfolio.title")}</a
			>
			<a href={tp("/support")} class="nav-link nav-link-secondary"
				>{t("support.title")}</a
			>
			<a href={tp("/research")} class="nav-link nav-link-secondary"
				>{t("research.title")}</a
			>
			<a href={tp("/blog")} class="nav-link nav-link-secondary"
				>{t("blog.title")}</a
			>
		</span>
		<a
			href="https://github.com/crafter-research"
			class="github-link site-header-github text-(--color-muted) hover:text-(--color-text) flex items-center transition-colors"
			target="_blank"
			rel="noreferrer"
			aria-label="GitHub"
			title="GitHub"
		>
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
			>
				<path
					d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"
				/>
			</svg>
		</a>
		<details class="site-header-menu">
			<summary>
				<svg
					aria-hidden="true"
					width="15"
					height="15"
					viewBox="0 0 16 16"
					fill="none"
				>
					<path
						d="M2 4h12M2 8h12M2 12h12"
						stroke="currentColor"
						stroke-width="1.25"
						stroke-linecap="round"
					></path>
				</svg>
				<span>{t("nav.menu")}</span>
			</summary>
			<div class="site-header-menu-panel">
				<a href={tp("/systems")}>{t("systems.title")}</a>
				<a href={tp("/projects")}>{t("portfolio.title")}</a>
				<a href={tp("/support")}>{t("support.title")}</a>
				<a href={tp("/research")}>{t("research.title")}</a>
				<a href={tp("/blog")}>{t("blog.title")}</a>
				<a
					href="https://github.com/crafter-research"
					target="_blank"
					rel="noreferrer"
					>GitHub ↗</a
				>
			</div>
		</details>
		<LanguagePicker />
		<ThemeSwitcher />
	</nav>
</header>

<script>
const menu = document.querySelector<HTMLDetailsElement>(".site-header-menu");
menu?.querySelectorAll("a").forEach((link) => {
	link.addEventListener("click", () => menu.removeAttribute("open"));
});
document.addEventListener("click", (event) => {
	if (menu?.open && !menu.contains(event.target as Node))
		menu.removeAttribute("open");
});
document.addEventListener("keydown", (event) => {
	if (event.key === "Escape" && menu?.open) {
		menu.removeAttribute("open");
		menu.querySelector("summary")?.focus();
	}
});
</script>
