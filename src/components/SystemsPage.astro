---
import { publicSystems, type SystemLocale } from "../data/public-systems";
import type { Lang } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const contentLang: SystemLocale = lang === "es" ? "es" : "en";
const inbox = "railly@crafterstation.com";

const copy = {
	en: {
		metaTitle: "Public Systems Observatory · Crafter Research",
		metaDescription:
			"Six evidence-first research records on public-sector AI systems in Peru, with sources, unknowns, review state, and correction routes.",
		eyebrow: "Public Systems Observatory / Peru alpha 01",
		title: "What can the public actually verify about government AI?",
		body: "Six source-backed research records make the visible evidence, unresolved questions, and review state inspectable. This alpha measures public documentation. It does not rate system safety, effectiveness, or institutional intent.",
		alpha: "Research alpha",
		alphaBody:
			"First-pass records · no second reviewer assigned · no agency response requested yet",
		verified: "systems documented",
		sectors: "public sectors",
		sources: "official sources linked",
		snapshot: "evidence snapshot",
		indexLabel: "Evidence index",
		indexTitle: "Six systems. Twelve questions each.",
		indexBody:
			"The strips show evidence coverage, not quality or safety: documented, partial, or not found publicly in the reviewed source set.",
		openRecord: "Open evidence record",
		sector: "Sector",
		reviewed: "Last reviewed",
		coverageLegend: ["not found publicly", "partial", "documented"],
		sectorLabels: {
			electoral: "Electoral",
			identity: "Identity",
			justice: "Justice",
			environment: "Environment",
			health: "Health",
		},
		record: "Research record",
		firstPass: "First-pass review",
		noAgencyResponse: "Agency response not requested",
		purpose: "Public purpose",
		decisionContext: "Decision context",
		inputs: "Inputs described",
		outputs: "Output described",
		oversight: "Human oversight",
		evaluation: "Public evaluation evidence",
		governance: "Public governance evidence",
		confirmed: "What the sources support",
		missing: "Missing public evidence",
		notFoundNote:
			"“Not found publicly” means we did not locate it in this source set. It never means the evidence or safeguard does not exist.",
		nextRequest: "Next evidence request",
		boundary: "Claim boundary",
		evidenceMap: "Evidence coverage map",
		evidenceMapBody:
			"Each cell represents recoverable documentation for one field. It is not a composite score.",
		dimensions: {
			existence: "Existence",
			purpose: "Purpose",
			owner: "Owner",
			inputs: "Inputs",
			output: "Output",
			oversight: "Oversight",
			evaluation: "Evaluation",
			privacy: "Privacy",
			audit: "Audit trail",
			correction: "Correction",
			updates: "Updates",
			contact: "Contact",
		},
		sourcesTitle: "Source ledger",
		openSource: "Open source",
		correction: "Submit a correction",
		agencyReply: "Send an agency response",
		correctionNote:
			"Corrections should identify the record, disputed field, replacement language, and a public source when possible.",
		agencyNote:
			"Institutions and system owners can add context, point to missing evidence, or request that a response be published alongside the record.",
		methodLabel: "Method and limits",
		methodTitle: "A public-evidence register, not a verdict engine.",
		methodBody:
			"We begin with official catalogs, directives, service pages, and institutional publications. Every positive claim needs a linked source. Unknowns remain unknown. A first-pass review is not independent replication.",
		methodItems: [
			[
				"01",
				"Collect",
				"Start with official public sources and preserve the exact URL.",
			],
			[
				"02",
				"Separate",
				"Keep confirmed facts, interpretations, and missing evidence distinct.",
			],
			[
				"03",
				"Review",
				"Expose review and agency-response state on every record.",
			],
			[
				"04",
				"Correct",
				"Version material changes and keep a public correction route.",
			],
		],
		limitsTitle: "Current limitations",
		limits: [
			"Only six systems are included in this alpha.",
			"No second reviewer is currently assigned.",
			"No agency right-of-reply request has been sent.",
			"The snapshot can lag internal or newly published documentation.",
			"Health records do not assess clinical safety or effectiveness.",
		],
		independenceTitle: "Independence",
		independenceBody:
			"Crafter Research is an independent public-interest lab by Crafter Station. The institutions listed here did not commission these records and have no editorial control. Material support for this work will be disclosed.",
		fallback:
			"Record content is shown in English for this locale while the full translation is prepared.",
	},
	es: {
		metaTitle: "Observatorio de Sistemas Públicos · Crafter Research",
		metaDescription:
			"Seis registros evidence-first sobre sistemas de IA del sector público peruano, con fuentes, incógnitas, revisión y correcciones.",
		eyebrow: "Observatorio de Sistemas Públicos / Perú alpha 01",
		title: "¿Qué puede verificar realmente el público sobre la IA del Estado?",
		body: "Seis registros con fuentes hacen inspeccionables la evidencia visible, las preguntas abiertas y el estado de revisión. Esta alpha mide documentación pública. No califica seguridad, efectividad ni intención institucional.",
		alpha: "Alpha de investigación",
		alphaBody:
			"Registros de primera pasada · sin segundo revisor asignado · sin respuesta institucional solicitada",
		verified: "sistemas documentados",
		sectors: "sectores públicos",
		sources: "fuentes oficiales enlazadas",
		snapshot: "snapshot de evidencia",
		indexLabel: "Índice de evidencia",
		indexTitle: "Seis sistemas. Doce preguntas cada uno.",
		indexBody:
			"Las tiras muestran cobertura de evidencia, no calidad o seguridad: documentada, parcial o no encontrada públicamente en las fuentes revisadas.",
		openRecord: "Abrir registro de evidencia",
		sector: "Sector",
		reviewed: "Última revisión",
		coverageLegend: ["no encontrada públicamente", "parcial", "documentada"],
		sectorLabels: {
			electoral: "Electoral",
			identity: "Identidad",
			justice: "Justicia",
			environment: "Ambiente",
			health: "Salud",
		},
		record: "Registro de investigación",
		firstPass: "Revisión de primera pasada",
		noAgencyResponse: "Respuesta institucional no solicitada",
		purpose: "Propósito público",
		decisionContext: "Contexto de decisión",
		inputs: "Inputs descritos",
		outputs: "Output descrito",
		oversight: "Supervisión humana",
		evaluation: "Evidencia pública de evaluación",
		governance: "Evidencia pública de gobernanza",
		confirmed: "Lo que sostienen las fuentes",
		missing: "Evidencia pública faltante",
		notFoundNote:
			"“No encontrada públicamente” significa que no la ubicamos en este conjunto de fuentes. Nunca significa que la evidencia o salvaguarda no exista.",
		nextRequest: "Próxima solicitud de evidencia",
		boundary: "Límite de la afirmación",
		evidenceMap: "Mapa de cobertura de evidencia",
		evidenceMapBody:
			"Cada celda representa documentación recuperable de un campo. No es un score compuesto.",
		dimensions: {
			existence: "Existencia",
			purpose: "Propósito",
			owner: "Responsable",
			inputs: "Inputs",
			output: "Output",
			oversight: "Supervisión",
			evaluation: "Evaluación",
			privacy: "Privacidad",
			audit: "Auditoría",
			correction: "Corrección",
			updates: "Cambios",
			contact: "Contacto",
		},
		sourcesTitle: "Ledger de fuentes",
		openSource: "Abrir fuente",
		correction: "Enviar una corrección",
		agencyReply: "Enviar una respuesta institucional",
		correctionNote:
			"La corrección debería identificar el registro, campo discutido, texto de reemplazo y una fuente pública cuando sea posible.",
		agencyNote:
			"Instituciones y responsables pueden agregar contexto, señalar evidencia faltante o pedir que publiquemos una respuesta junto al registro.",
		methodLabel: "Método y límites",
		methodTitle: "Un registro de evidencia pública, no un motor de veredictos.",
		methodBody:
			"Partimos de catálogos, directivas, páginas de servicio y publicaciones institucionales. Cada afirmación positiva requiere una fuente enlazada. Las incógnitas siguen siendo incógnitas. Una primera revisión no es replicación independiente.",
		methodItems: [
			[
				"01",
				"Recolectar",
				"Empezar con fuentes públicas oficiales y conservar la URL exacta.",
			],
			[
				"02",
				"Separar",
				"Mantener distintos los hechos confirmados, interpretaciones y vacíos.",
			],
			[
				"03",
				"Revisar",
				"Exponer el estado de revisión y respuesta institucional en cada registro.",
			],
			[
				"04",
				"Corregir",
				"Versionar cambios materiales y mantener una ruta pública de corrección.",
			],
		],
		limitsTitle: "Limitaciones actuales",
		limits: [
			"Esta alpha solo incluye seis sistemas.",
			"Actualmente no hay un segundo revisor asignado.",
			"Todavía no se envió una solicitud de derecho a respuesta.",
			"El snapshot puede estar detrás de documentación interna o recién publicada.",
			"Los registros de salud no evalúan seguridad clínica ni efectividad.",
		],
		independenceTitle: "Independencia",
		independenceBody:
			"Crafter Research es un laboratorio independiente de interés público de Crafter Station. Las instituciones listadas no encargaron estos registros ni tienen control editorial. Declararemos todo apoyo material a este trabajo.",
		fallback: "",
	},
}[contentLang];

const coverageEntries = Object.keys(publicSystems[0].coverage) as Array<
	keyof (typeof publicSystems)[number]["coverage"]
>;
const officialSourceCount = new Set(
	publicSystems.flatMap((record) => record.sources.map((source) => source.url)),
).size;
const fmtDate = (value: string) =>
	new Date(`${value}T00:00:00Z`).toLocaleDateString(
		contentLang === "es" ? "es-PE" : "en-US",
		{ day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" },
	);
const mailto = (subject: string) =>
	`mailto:${inbox}?subject=${encodeURIComponent(subject)}`;
---

<Layout title={copy.metaTitle} description={copy.metaDescription} lang={lang}>
	<main class="systems-observatory">
		<header class="systems-hero">
			<div class="systems-hero-copy">
				<p class="systems-eyebrow">{copy.eyebrow}</p>
				<h1>{copy.title}</h1>
				<p class="systems-hero-body">{copy.body}</p>
				{lang !== "en" && lang !== "es" && <small>{copy.fallback}</small>}
				<div class="systems-alpha-note">
					<span>{copy.alpha}</span>
					<p>{copy.alphaBody}</p>
				</div>
			</div>
			<dl class="systems-totals">
				<div>
					<dt>06</dt>
					<dd>{copy.verified}</dd>
				</div>
				<div>
					<dt>05</dt>
					<dd>{copy.sectors}</dd>
				</div>
				<div>
					<dt>{officialSourceCount}</dt>
					<dd>{copy.sources}</dd>
				</div>
				<div>
					<dt>28.06</dt>
					<dd>{copy.snapshot}</dd>
				</div>
			</dl>
		</header>

		<section
			class="systems-index-section"
			aria-labelledby="systems-index-title"
		>
			<div class="systems-section-heading">
				<div>
					<p class="systems-eyebrow">{copy.indexLabel}</p>
					<h2 id="systems-index-title">{copy.indexTitle}</h2>
				</div>
				<p>{copy.indexBody}</p>
			</div>
			<div
				class="coverage-legend"
				role="group"
				aria-label="Evidence coverage legend"
			>
				{copy.coverageLegend.map((label, index) => (
					<span><i class={`coverage-${index}`}></i>{label}</span>
				))}
			</div>
			<div class="systems-index">
				{publicSystems.map((record, index) => (
					<a href={`#${record.slug}`} class="system-index-row">
						<span class="system-index-number">{String(index + 1).padStart(2, "0")}</span>
						<div class="system-index-identity">
							<span>{record.agency}</span>
							<strong>{record.name}</strong>
							<p>{record.purpose[contentLang]}</p>
						</div>
						<div class="system-index-meta">
							<span>{copy.sector}: {copy.sectorLabels[record.sector]}</span>
							<span>{copy.reviewed}: {fmtDate(record.lastReviewed)}</span>
						</div>
						<div class="coverage-strip" role="img" aria-label={`${record.name}: ${copy.evidenceMap}`}>
							{coverageEntries.map((dimension) => (
								<i class={`coverage-${record.coverage[dimension]}`} title={`${copy.dimensions[dimension]}: ${copy.coverageLegend[record.coverage[dimension]]}`}></i>
							))}
						</div>
						<span class="system-index-open">{copy.openRecord} ↓</span>
					</a>
				))}
			</div>
		</section>

		<section class="systems-records" aria-label={copy.indexTitle}>
			{publicSystems.map((record, index) => (
				<article id={record.slug} class="system-dossier">
					<header class="dossier-header">
						<div class="dossier-index">{String(index + 1).padStart(2, "0")}<span>/ 06</span></div>
						<div class="dossier-title">
							<p class="systems-eyebrow">{copy.record} · {copy.sectorLabels[record.sector]}</p>
							<h2>{record.name}</h2>
							<p>{record.agency}</p>
						</div>
						<div class="dossier-state">
							<span class="state-first">{copy.firstPass}</span>
							<span>{copy.noAgencyResponse}</span>
							<time datetime={record.lastReviewed}>{fmtDate(record.lastReviewed)}</time>
						</div>
					</header>

					<div class="dossier-overview">
						<div class="dossier-lead">
							<p class="dossier-label">{copy.purpose}</p>
							<p>{record.purpose[contentLang]}</p>
						</div>
						<div><p class="dossier-label">{copy.decisionContext}</p><p>{record.decisionContext[contentLang]}</p></div>
						<div><p class="dossier-label">{copy.inputs}</p><p>{record.dataInputs[contentLang]}</p></div>
						<div><p class="dossier-label">{copy.outputs}</p><p>{record.outputs[contentLang]}</p></div>
						<div><p class="dossier-label">{copy.oversight}</p><p>{record.humanOversight[contentLang]}</p></div>
						<div><p class="dossier-label">{copy.evaluation}</p><p>{record.publicEvaluation[contentLang]}</p></div>
						<div><p class="dossier-label">{copy.governance}</p><p>{record.publicGovernance[contentLang]}</p></div>
					</div>

					<div class="dossier-evidence-columns">
						<section class="evidence-confirmed">
							<p class="dossier-label">{copy.confirmed}</p>
							<ul>{record.confirmed.map((item) => <li>{item[contentLang]}</li>)}</ul>
						</section>
						<section class="evidence-missing">
							<p class="dossier-label">{copy.missing}</p>
							<ul>{record.missingPublicEvidence.map((item) => <li>{item[contentLang]}</li>)}</ul>
							<small>{copy.notFoundNote}</small>
						</section>
						<section class="evidence-next">
							<p class="dossier-label">{copy.nextRequest}</p>
							<p>{record.nextEvidenceRequest[contentLang]}</p>
						</section>
					</div>

					<div class="dossier-coverage">
						<div class="dossier-coverage-intro">
							<p class="dossier-label">{copy.evidenceMap}</p>
							<p>{copy.evidenceMapBody}</p>
						</div>
						<div class="coverage-matrix">
							{coverageEntries.map((dimension) => (
								<div>
									<span>{copy.dimensions[dimension]}</span>
									<i class={`coverage-${record.coverage[dimension]}`}></i>
									<small>{copy.coverageLegend[record.coverage[dimension]]}</small>
								</div>
							))}
						</div>
					</div>

					<div class="dossier-boundary">
						<p class="dossier-label">{copy.boundary}</p>
						<p>{record.boundary[contentLang]}</p>
					</div>

					<div class="dossier-footer">
						<section class="source-ledger">
							<p class="dossier-label">{copy.sourcesTitle}</p>
							{record.sources.map((source, sourceIndex) => (
								<a href={source.url} target="_blank" rel="noreferrer">
									<span>{String(sourceIndex + 1).padStart(2, "0")} · {source.type[contentLang]}</span>
									<strong>{source.label[contentLang]}</strong>
									<small>{copy.openSource} ↗</small>
								</a>
							))}
						</section>
						<div class="response-routes">
							<a href={mailto(`Correction: ${record.name} public system record`)}>
								<strong>{copy.correction} ↗</strong><span>{copy.correctionNote}</span>
							</a>
							<a href={mailto(`Agency response: ${record.name} public system record`)}>
								<strong>{copy.agencyReply} ↗</strong><span>{copy.agencyNote}</span>
							</a>
						</div>
					</div>
				</article>
			))}
		</section>

		<section class="systems-method" aria-labelledby="systems-method-title">
			<div class="systems-method-intro">
				<p class="systems-eyebrow">{copy.methodLabel}</p>
				<h2 id="systems-method-title">{copy.methodTitle}</h2>
				<p>{copy.methodBody}</p>
			</div>
			<div class="systems-method-steps">
				{copy.methodItems.map(([number, title, body]) => (
					<article><span>{number}</span><strong>{title}</strong><p>{body}</p></article>
				))}
			</div>
			<div class="systems-limitations">
				<div>
					<p class="dossier-label">{copy.limitsTitle}</p>
					<ul>
						{copy.limits.map((limit) => <li>{limit}</li>)}
					</ul>
				</div>
				<div>
					<p class="dossier-label">{copy.independenceTitle}</p>
					<p>{copy.independenceBody}</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
.systems-observatory {
	--systems-gutter: clamp(5rem, 8.5vw, 8rem);
	margin: 0 auto;
	max-width: 96rem;
	padding: 0 var(--systems-gutter) 7rem;
}
.systems-hero {
	align-items: end;
	display: grid;
	gap: clamp(3rem, 8vw, 8rem);
	grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.7fr);
	min-height: calc(90svh - var(--header-height));
	padding: clamp(7rem, 12vw, 10rem) 0 clamp(5rem, 8vw, 7rem);
}
.systems-hero-copy {
	max-width: 61rem;
}
.systems-eyebrow,
.dossier-label {
	color: var(--color-accent);
	font-family: var(--font-mono);
	font-size: 0.68rem;
	letter-spacing: 0.15em;
	text-transform: uppercase;
}
.systems-hero h1 {
	color: var(--color-text);
	font-size: clamp(3rem, 6.2vw, 6.2rem);
	font-weight: 470;
	letter-spacing: -0.055em;
	line-height: 0.95;
	margin-top: 1.35rem;
	max-width: 12ch;
	text-wrap: balance;
}
.systems-hero-body {
	color: var(--color-muted-strong);
	font-size: clamp(1rem, 1.5vw, 1.22rem);
	line-height: 1.72;
	margin-top: 1.7rem;
	max-width: 47rem;
}
.systems-hero-copy > small {
	color: var(--color-muted);
	display: block;
	font-family: var(--font-mono);
	font-size: 0.72rem;
	margin-top: 1rem;
}
.systems-alpha-note {
	align-items: baseline;
	border-bottom: 1px solid var(--color-border);
	border-top: 1px solid var(--color-border);
	display: grid;
	gap: 1rem;
	grid-template-columns: auto 1fr;
	margin-top: 2.2rem;
	max-width: 47rem;
	padding: 0.85rem 0;
}
.systems-alpha-note span {
	color: var(--color-accent);
	font-family: var(--font-mono);
	font-size: 0.64rem;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}
.systems-alpha-note p {
	color: var(--color-muted);
	font-size: 0.82rem;
	line-height: 1.5;
}
.systems-totals {
	border-top: 1px solid var(--color-border);
	margin: 0;
}
.systems-totals div {
	align-items: baseline;
	border-bottom: 1px solid var(--color-border);
	display: grid;
	gap: 1rem;
	grid-template-columns: 5rem 1fr;
	padding: 0.9rem 0;
}
.systems-totals dt {
	color: var(--color-text);
	font-family: var(--font-mono);
	font-size: 1.45rem;
	font-weight: 500;
}
.systems-totals dd {
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.68rem;
	letter-spacing: 0.1em;
	margin: 0;
	text-transform: uppercase;
}
.systems-index-section,
.systems-method {
	border-top: 1px solid var(--color-border);
	padding: clamp(5rem, 8vw, 7.5rem) 0;
}
.systems-section-heading {
	align-items: end;
	display: grid;
	gap: 2rem;
	grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.58fr);
	margin-bottom: 2.5rem;
}
.systems-section-heading h2,
.systems-method-intro h2 {
	color: var(--color-text);
	font-size: clamp(2rem, 4vw, 4rem);
	font-weight: 480;
	letter-spacing: -0.04em;
	line-height: 1;
	margin-top: 0.85rem;
	max-width: 16ch;
	text-wrap: balance;
}
.systems-section-heading > p,
.systems-method-intro > p:not(.systems-eyebrow) {
	color: var(--color-muted-strong);
	line-height: 1.65;
	max-width: 38rem;
}
.coverage-legend {
	display: flex;
	flex-wrap: wrap;
	gap: 1rem;
	justify-content: end;
	margin-bottom: 1rem;
}
.coverage-legend span {
	align-items: center;
	color: var(--color-muted);
	display: inline-flex;
	font-family: var(--font-mono);
	font-size: 0.62rem;
	gap: 0.45rem;
	text-transform: uppercase;
}
.coverage-legend i,
.coverage-matrix i {
	display: block;
	height: 0.5rem;
	width: 0.5rem;
}
.coverage-0 {
	background: transparent;
	border: 1px solid var(--color-muted);
	opacity: 0.52;
}
.coverage-1 {
	background: color-mix(in srgb, var(--color-accent) 32%, transparent);
	border: 1px solid color-mix(in srgb, var(--color-accent) 58%, transparent);
}
.coverage-2 {
	background: var(--color-accent);
	border: 1px solid var(--color-accent);
}
.systems-index {
	border-top: 1px solid var(--color-border);
	display: grid;
}
.system-index-row {
	align-items: center;
	border-bottom: 1px solid var(--color-border);
	color: inherit;
	display: grid;
	gap: 1.25rem;
	grid-template-columns: 2.5rem minmax(15rem, 1.1fr) minmax(11rem, 0.55fr) minmax(
			9rem,
			0.6fr
		) auto;
	padding: 1.35rem 0;
	transition:
		background-color 160ms ease,
		padding 160ms ease;
}
.system-index-row:hover {
	background: color-mix(in srgb, var(--color-accent) 3%, transparent);
	padding-left: 0.65rem;
	padding-right: 0.65rem;
}
.system-index-number {
	color: var(--color-muted);
