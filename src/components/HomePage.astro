---
import { getCollection } from "astro:content";
import type { Lang } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";
import LanguagePicker from "./LanguagePicker.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const contentLang = lang === "es" ? "es" : "en";

const copy = {
	en: {
		description:
			"Crafter Research is an AI research lab in Lima building datasets, evaluation harnesses, agent systems, and civic-tech prototypes for LATAM.",
		label: "Crafter Research",
		navLog: "Research log",
		kicker: "Crafter Research / Lima, Peru",
		heroTitle: "AI research from LATAM.",
		heroBody:
			"We turn public systems into datasets, evals, agents, and working prototypes.",
		primaryCta: "Read the log",
		secondaryCta: "GitHub",
		instrumentLabel: "research line",
		instrumentTitle: "question -> corpus -> eval -> system",
		instrumentBody: "Civic tech is the testbed. AI research is the work.",
		chainLabel: "Research loop",
		chainTitle: "Question to system.",
		chainBody: "Corpus, eval, agent, prototype, paper.",
		ledgerLabel: "Current programs",
		ledgerTitle: "Current tracks.",
		ledgerBody: "Legal AI, language evals, gov adapters, civic data.",
		logLabel: "Lab notes",
		logTitle: "Notes from live work.",
		logCta: "Read all notes",
		stanceLabel: "Operating stance",
		stanceTitle: "AI research, grounded in public systems.",
		footerMade: "Made by",
		footerAnd: "and",
		footerStation: "Crafter Station",
	},
	es: {
		description:
			"Crafter Research es un AI research lab en Lima que construye datasets, evals, sistemas de agentes y prototipos civic-tech para LATAM.",
		label: "Crafter Research",
		navLog: "Registro",
		kicker: "Crafter Research / Lima, Peru",
		heroTitle: "AI research desde LATAM.",
		heroBody:
			"Convertimos sistemas publicos en datasets, evals, agentes y prototipos funcionando.",
		primaryCta: "Leer registro",
		secondaryCta: "GitHub",
		instrumentLabel: "research line",
		instrumentTitle: "pregunta -> corpus -> eval -> sistema",
		instrumentBody: "Civic tech es el testbed. AI research es el trabajo.",
		chainLabel: "Loop de research",
		chainTitle: "Pregunta a sistema.",
		chainBody: "Corpus, eval, agente, prototipo, paper.",
		ledgerLabel: "Programas actuales",
		ledgerTitle: "Tracks actuales.",
		ledgerBody: "Legal AI, evals de lenguaje, gov adapters, data civica.",
		logLabel: "Notas del lab",
		logTitle: "Notas desde trabajo vivo.",
		logCta: "Leer todas las notas",
		stanceLabel: "Postura operativa",
		stanceTitle: "AI research anclado en sistemas publicos.",
		footerMade: "Hecho por",
		footerAnd: "y",
		footerStation: "Crafter Station",
	},
} as const;

const c = copy[contentLang];
const homeHref = contentLang === "es" ? "/es" : "/";
const researchHref = contentLang === "es" ? "/es/research" : "/research";

const heroSignalsByLang = {
	en: [
		["corpus", "legalize-pe", "Git-versioned legal data"],
		["evals", "LatamBench", "Spanish model behavior"],
		["agents", "Amicus", "Retrieval systems with citations"],
		["adapters", "*-cli", "Government portals as tools"],
	],
	es: [
		["corpus", "legalize-pe", "Data legal git-versionada"],
		["evals", "LatamBench", "Comportamiento de modelos en espanol"],
		["agentes", "Amicus", "Retrieval con citas"],
		["adapters", "*-cli", "Portales de gobierno como tools"],
	],
} as const;

const chainByLang = {
	en: [
		["01", "Question", "A research question tied to a real civic system."],
		["02", "Dataset", "Public data made reusable, versioned, and citable."],
		["03", "Eval", "A harness that can make the idea fail in public."],
		["04", "Agent", "Retrieval or tool-use systems built from the artifacts."],
		["05", "Prototype", "A working surface people can inspect or reuse."],
		["06", "Paper/log", "The argument linked back to code, data, and runs."],
	],
	es: [
		[
			"01",
			"Pregunta",
			"Una pregunta de research atada a un sistema civico real.",
		],
		["02", "Dataset", "Data publica reusable, versionada y citable."],
		["03", "Eval", "Un harness que puede hacer fallar la idea en publico."],
		["04", "Agente", "Retrieval o tool-use construido desde los artefactos."],
		[
			"05",
			"Prototipo",
			"Una superficie funcionando que otros pueden inspeccionar.",
		],
		["06", "Paper/log", "El argumento enlazado a codigo, data y runs."],
	],
} as const;

const ledgerByLang = {
	en: [
		[
			"Legal AI",
			"legalize-pe / amicus",
			"Open legal corpora, retrieval evals, and citation-grounded assistants for Peruvian law.",
			"Corpus, SDK, paper track",
		],
		[
			"Language evals",
			"LatamBench",
			"Latin American Spanish evals that separate correctness, abstention, and hallucination.",
			"Harness, judge artifacts",
		],
		[
			"Gov adapters",
			"sunat-cli / seace / jne",
			"Agent-first CLIs that turn hostile public portals into reliable tools.",
			"Adapters, audit logs",
		],
		[
			"Civic data systems",
			"peru-financia / political-graph",
			"Public data products for finance, elections, and institutional relationships.",
			"Maps, graphs, datasets",
		],
	],
	es: [
		[
			"Legal AI",
			"legalize-pe / amicus",
			"Corpora legales abiertos, evals de retrieval y asistentes con citas para ley peruana.",
			"Corpus, SDK, papers",
		],
		[
			"Evals de lenguaje",
			"LatamBench",
			"Evals de espanol LATAM que separan correctitud, abstencion y alucinacion.",
			"Harness, artefactos juez",
		],
		[
			"Adapters de gobierno",
			"sunat-cli / seace / jne",
			"CLIs agent-first que convierten portales publicos hostiles en tools confiables.",
			"Adapters, audit logs",
		],
		[
			"Sistemas de data civica",
			"peru-financia / political-graph",
			"Productos publicos para financiamiento, elecciones y relaciones institucionales.",
			"Mapas, grafos, datasets",
		],
	],
} as const;

const stanceByLang = {
	en: [
		[
			"AI research first",
			"Civic tech is the field site, not the whole identity.",
		],
		[
			"Prototype as research artifact",
			"A working system should make the paper more inspectable, not just more marketable.",
		],
		[
			"LATAM as a hard setting",
			"Messy public data, weak APIs, and Spanish-language gaps are research constraints worth studying.",
		],
	],
	es: [
		[
			"AI research primero",
			"Civic tech es el campo de prueba, no toda la identidad.",
		],
		[
			"Prototipo como artefacto de research",
			"Un sistema funcionando debe hacer el paper mas inspeccionable, no solo mas marketeable.",
		],
		[
			"LATAM como setting dificil",
			"Data publica desordenada, APIs debiles y gaps en espanol son restricciones de research reales.",
		],
	],
} as const;

const heroSignals = heroSignalsByLang[contentLang];
const chain = chainByLang[contentLang];
const ledger = ledgerByLang[contentLang];
const stance = stanceByLang[contentLang];

const posts = (await getCollection("research"))
	.filter((post) => post.data.lang === contentLang)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const fmtDate = (d: Date) =>
	d.toLocaleDateString(contentLang === "es" ? "es-PE" : "en-US", {
		day: "numeric",
		month: "short",
		timeZone: "UTC",
		year: "numeric",
	});
---

<Layout title={c.label} description={c.description} lang={contentLang}>
	<main class="min-h-screen overflow-x-clip">
		<header class="site-hero">
			<picture class="hero-picture" data-theme-picture aria-hidden="true">
				<source media="(prefers-color-scheme: dark)" srcset="/gen/research-hero-dark.png" />
				<img
					src="/gen/research-hero-light.png"
					data-dark-src="/gen/research-hero-dark.png"
					data-light-src="/gen/research-hero-light.png"
					alt=""
					width="1717"
					height="916"
				/>
			</picture>
			<nav class="site-nav">
				<a href={homeHref} class="flex min-w-0 items-center gap-3 text-(--color-text)">
					<img src="/favicon.svg" alt="" class="size-8" />
					<span class="font-mono text-xs tracking-[0.18em] uppercase">{c.label}</span>
				</a>
				<div class="flex max-w-full flex-wrap items-center gap-3 sm:justify-end">
					<a href={researchHref} class="nav-link">{c.navLog}</a>
					<a href="https://github.com/crafter-research" class="nav-link" target="_blank" rel="noreferrer">
						GitHub
					</a>
					<LanguagePicker />
				</div>
			</nav>

			<section class="hero-content">
				<p class="section-label">{c.kicker}</p>
				<h1>{c.heroTitle}</h1>
				<p>{c.heroBody}</p>
				<div class="hero-actions">
					<a href={researchHref} class="button-primary">{c.primaryCta}</a>
					<a href="https://github.com/crafter-research" target="_blank" rel="noreferrer" class="button-secondary">
						{c.secondaryCta}
					</a>
				</div>
			</section>
		</header>

		<section class="thesis-section">
			<div class="section-intro">
				<p class="section-label">{c.instrumentLabel}</p>
				<h2 class="section-title">{c.instrumentTitle}</h2>
				<p>{c.instrumentBody}</p>
			</div>
			<div class="signal-list">
				{
					heroSignals.map(([type, title, body]) => (
						<article>
							<span>{type}</span>
							<strong>{title}</strong>
							<p>{body}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="program-section">
			<div class="section-intro">
				<p class="section-label">{c.ledgerLabel}</p>
				<h2 class="section-title">{c.ledgerTitle}</h2>
				<p>{c.ledgerBody}</p>
			</div>
			<div class="program-list">
				{
					ledger.map(([field, instrument, question, surface], itemIndex) => (
						<article class="program-row">
							<span>{String(itemIndex + 1).padStart(2, "0")}</span>
							<div class="program-name">
								<strong>{field}</strong>
								<em>{instrument}</em>
							</div>
							<p>{question}</p>
							<small>{surface}</small>
						</article>
					))
				}
			</div>
		</section>

		<section class="method-section">
			<div class="section-intro">
				<p class="section-label">{c.chainLabel}</p>
				<h2 class="section-title">{c.chainTitle}</h2>
				<p>{c.chainBody}</p>
			</div>
			<div class="method-grid">
				{
					chain.map(([index, title, body]) => (
						<article>
							<span>{index}</span>
							<strong>{title}</strong>
							<p>{body}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="log-section">
			<div class="section-intro">
				<p class="section-label">{c.logLabel}</p>
				<h2 class="section-title">{c.logTitle}</h2>
				<a href={researchHref}>{c.logCta}</a>
			</div>
			<div class="notes-list">
				{
					posts.map((post, index) => (
						<a href={`${researchHref}/${post.data.urlSlug}`} class={index === 0 ? "log-card is-featured" : "log-card"}>
							<div class="log-meta">
								<span class="pill">{post.data.status}</span>
								<span class="font-mono text-xs text-(--color-muted)">
									{fmtDate(post.data.date)} / {post.data.project}
								</span>
							</div>
							<h3 class="mt-4 text-2xl font-semibold leading-tight text-(--color-text)">
								{post.data.title}
							</h3>
							<p class="mt-3 text-sm leading-6 text-(--color-muted-strong)">{post.data.description}</p>
						</a>
					))
				}
			</div>
		</section>

		<section class="stance-section">
			<div class="stance-inner">
				<div>
					<p class="section-label">{c.stanceLabel}</p>
					<h2 class="section-title">{c.stanceTitle}</h2>
				</div>
				<div class="stance-list">
					{
						stance.map(([title, body]) => (
							<article>
								<strong>{title}</strong>
								<p>{body}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<footer class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-10 text-sm text-(--color-muted) sm:px-8 md:flex-row md:items-center md:justify-between lg:px-10">
			<p>
				{c.footerMade} <a class="footer-link" href="https://shiara.design" target="_blank" rel="noreferrer">Shiara Arauzo</a> {c.footerAnd} <a class="footer-link" href="https://railly.dev" target="_blank" rel="noreferrer">Railly Hugo</a>
			</p>
			<div class="flex flex-wrap gap-4">
				<a class="footer-link" href="https://crafterstation.com" target="_blank" rel="noreferrer">{c.footerStation}</a>
				<a class="footer-link" href="https://github.com/crafter-research" target="_blank" rel="noreferrer">GitHub</a>
				<a class="footer-link" href={researchHref}>{c.navLog}</a>
			</div>
		</footer>
	</main>
</Layout>
