---
import { getCollection } from "astro:content";
import type { Lang } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";
import LanguagePicker from "./LanguagePicker.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const contentLang = lang === "es" ? "es" : "en";

const copy = {
	en: {
		description:
			"Crafter Research is an AI research lab in Lima building datasets, evaluation harnesses, agent systems, and civic-tech prototypes for LATAM.",
		label: "Crafter Research",
		navLog: "Research log",
		kicker: "Crafter Research / Lima, Peru",
		heroTitle: "AI research for public systems.",
		heroBody:
			"We build corpora, evals, agents, and working interfaces for the messy institutions people actually depend on.",
		primaryCta: "Read the log",
		secondaryCta: "GitHub",
		instrumentLabel: "Field thesis",
		instrumentTitle: "Public systems are frontier research environments.",
		instrumentBody:
			"LATAM gives us brittle portals, fragmented law, weak APIs, and Spanish-language gaps. We turn those constraints into inspectable AI systems.",
		chainLabel: "Lab apparatus",
		chainTitle: "From public friction to reusable evidence.",
		chainBody: "Question, corpus, eval, agent, interface, research log.",
		ledgerLabel: "Current programs",
		ledgerTitle: "Four lines of work.",
		ledgerBody:
			"Legal AI, language evals, gov adapters, and civic data systems.",
		logLabel: "Lab notes",
		logTitle: "Research logs with receipts.",
		logCta: "Read all notes",
		stanceLabel: "Operating stance",
		stanceTitle: "A small lab, built for evidence over theater.",
		footerMade: "Made by",
		footerAnd: "and",
		footerStation: "Crafter Station",
	},
	es: {
		description:
			"Crafter Research es un AI research lab en Lima que construye datasets, evals, sistemas de agentes y prototipos civic-tech para LATAM.",
		label: "Crafter Research",
		navLog: "Registro",
		kicker: "Crafter Research / Lima, Peru",
		heroTitle: "AI research para sistemas publicos.",
		heroBody:
			"Construimos corpora, evals, agentes e interfaces funcionando para las instituciones desordenadas de las que la gente depende.",
		primaryCta: "Leer registro",
		secondaryCta: "GitHub",
		instrumentLabel: "Tesis de campo",
		instrumentTitle: "Los sistemas publicos son entornos frontier de research.",
		instrumentBody:
			"LATAM nos da portales fragiles, ley fragmentada, APIs debiles y gaps en espanol. Convertimos esas restricciones en sistemas de AI inspeccionables.",
		chainLabel: "Aparato del lab",
		chainTitle: "De friccion publica a evidencia reusable.",
		chainBody: "Pregunta, corpus, eval, agente, interfaz, research log.",
		ledgerLabel: "Programas actuales",
		ledgerTitle: "Cuatro lineas de trabajo.",
		ledgerBody:
			"Legal AI, evals de lenguaje, gov adapters y sistemas de data civica.",
		logLabel: "Notas del lab",
		logTitle: "Research logs con recibos.",
		logCta: "Leer todas las notas",
		stanceLabel: "Postura operativa",
		stanceTitle: "Un lab pequeno, hecho para evidencia antes que teatro.",
		footerMade: "Hecho por",
		footerAnd: "y",
		footerStation: "Crafter Station",
	},
} as const;

const c = copy[contentLang];
const homeHref = contentLang === "es" ? "/es" : "/";
const researchHref = contentLang === "es" ? "/es/research" : "/research";

const heroPathByLang = {
	en: [
		"public friction",
		"corpus",
		"eval",
		"agent",
		"interface",
		"research log",
	],
	es: [
		"friccion publica",
		"corpus",
		"eval",
		"agente",
		"interfaz",
		"research log",
	],
} as const;

const heroSignalsByLang = {
	en: [
		[
			"field",
			"Public friction",
			"Government portals, fragmented law, and civic data become research settings.",
		],
		[
			"artifact",
			"Inspectable systems",
			"Every claim should point to a corpus, benchmark, run, interface, or repo.",
		],
		[
			"setting",
			"LATAM Spanish",
			"Language and institutional gaps are treated as first-class evaluation targets.",
		],
	],
	es: [
		[
			"campo",
			"Friccion publica",
			"Portales de gobierno, ley fragmentada y data civica se vuelven entornos de research.",
		],
		[
			"artefacto",
			"Sistemas inspeccionables",
			"Cada claim debe apuntar a un corpus, benchmark, run, interfaz o repo.",
		],
		[
			"setting",
			"Espanol LATAM",
			"Los gaps de lenguaje e instituciones son targets de evaluacion de primer orden.",
		],
	],
} as const;

const chainByLang = {
	en: [
		["01", "Question", "A research question tied to a real civic system."],
		["02", "Dataset", "Public data made reusable, versioned, and citable."],
		["03", "Eval", "A harness that can make the idea fail in public."],
		["04", "Agent", "Retrieval or tool-use systems built from the artifacts."],
		["05", "Prototype", "A working surface people can inspect or reuse."],
		["06", "Paper/log", "The argument linked back to code, data, and runs."],
	],
	es: [
		[
			"01",
			"Pregunta",
			"Una pregunta de research atada a un sistema civico real.",
		],
		["02", "Dataset", "Data publica reusable, versionada y citable."],
		["03", "Eval", "Un harness que puede hacer fallar la idea en publico."],
		["04", "Agente", "Retrieval o tool-use construido desde los artefactos."],
		[
			"05",
			"Prototipo",
			"Una superficie funcionando que otros pueden inspeccionar.",
		],
		["06", "Paper/log", "El argumento enlazado a codigo, data y runs."],
	],
} as const;

const ledgerByLang = {
	en: [
		[
			"Legal AI",
			"legalize-pe / amicus",
			"Open legal corpora, retrieval evals, and citation-grounded assistants for Peruvian law.",
			"Corpus, SDK, paper track",
		],
		[
			"Language evals",
			"LatamBench",
			"Latin American Spanish evals that separate correctness, abstention, and hallucination.",
			"Harness, judge artifacts",
		],
		[
			"Gov adapters",
			"sunat-cli / seace / jne",
			"Agent-first CLIs that turn hostile public portals into reliable tools.",
			"Adapters, audit logs",
		],
		[
			"Civic data systems",
			"peru-financia / political-graph",
			"Public data products for finance, elections, and institutional relationships.",
			"Maps, graphs, datasets",
		],
	],
	es: [
		[
			"Legal AI",
			"legalize-pe / amicus",
			"Corpora legales abiertos, evals de retrieval y asistentes con citas para ley peruana.",
			"Corpus, SDK, papers",
		],
		[
			"Evals de lenguaje",
			"LatamBench",
			"Evals de espanol LATAM que separan correctitud, abstencion y alucinacion.",
			"Harness, artefactos juez",
		],
		[
			"Adapters de gobierno",
			"sunat-cli / seace / jne",
			"CLIs agent-first que convierten portales publicos hostiles en tools confiables.",
			"Adapters, audit logs",
		],
		[
			"Sistemas de data civica",
			"peru-financia / political-graph",
			"Productos publicos para financiamiento, elecciones y relaciones institucionales.",
			"Mapas, grafos, datasets",
		],
	],
} as const;

const stanceByLang = {
	en: [
		[
			"AI research first",
			"Civic tech is the field site, not the whole identity.",
		],
		[
			"Prototype as research artifact",
			"A working system should make the paper more inspectable, not just more marketable.",
		],
		[
			"LATAM as a hard setting",
			"Messy public data, weak APIs, and Spanish-language gaps are research constraints worth studying.",
		],
	],
	es: [
		[
			"AI research primero",
			"Civic tech es el campo de prueba, no toda la identidad.",
		],
		[
			"Prototipo como artefacto de research",
			"Un sistema funcionando debe hacer el paper mas inspeccionable, no solo mas marketeable.",
		],
		[
			"LATAM como setting dificil",
			"Data publica desordenada, APIs debiles y gaps en espanol son restricciones de research reales.",
		],
	],
} as const;

const heroSignals = heroSignalsByLang[contentLang];
const heroPath = heroPathByLang[contentLang];
const chain = chainByLang[contentLang];
const ledger = ledgerByLang[contentLang];
const stance = stanceByLang[contentLang];

const posts = (await getCollection("research"))
	.filter((post) => post.data.lang === contentLang)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const fmtDate = (d: Date) =>
	d.toLocaleDateString(contentLang === "es" ? "es-PE" : "en-US", {
		day: "numeric",
		month: "short",
		timeZone: "UTC",
		year: "numeric",
	});
---

<Layout title={c.label} description={c.description} lang={contentLang}>
	<main class="research-index">
		<header class="index-shell">
			<nav class="index-nav">
				<a href={homeHref} class="index-brand">
					<span class="brand-glyph" aria-hidden="true"></span>
					<span>{c.label}</span>
				</a>
				<div class="index-links">
					<a href={researchHref} class="nav-link">{c.navLog}</a>
					<a href="https://github.com/crafter-research" class="nav-link" target="_blank" rel="noreferrer">
						GitHub
					</a>
					<LanguagePicker />
				</div>
			</nav>

			<section class="index-hero">
				<p class="section-label">{c.kicker}</p>
				<h1>{c.heroTitle}</h1>
				<p>{c.heroBody}</p>
				<div class="index-system" aria-label="Research system">
					{
						heroPath.map((item) => <span>{item}</span>)
					}
				</div>
			</section>
		</header>

		<section class="research-feed" aria-label="Crafter Research operating system">
			<article class="feed-entry feed-entry-featured">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta">
						<span>{c.instrumentLabel}</span>
					</div>
					<h2>{c.instrumentTitle}</h2>
					<p>{c.instrumentBody}</p>
					<div class="signal-strip">
						{
							heroSignals.map(([type, title, body]) => (
								<article>
									<span>{type}</span>
									<strong>{title}</strong>
									<p>{body}</p>
								</article>
							))
						}
					</div>
				</div>
			</article>

			<article class="feed-entry">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta">
						<span>{c.chainLabel}</span>
					</div>
					<h2>{c.chainTitle}</h2>
					<p>{c.chainBody}</p>
					<ol class="method-list">
						{
							chain.map(([_index, title, body]) => (
								<li>
									<strong>{title}</strong>
									<p>{body}</p>
								</li>
							))
						}
					</ol>
				</div>
			</article>

			<article class="feed-entry">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta">
						<span>{c.ledgerLabel}</span>
					</div>
					<h2>{c.ledgerTitle}</h2>
					<p>{c.ledgerBody}</p>
					<div class="program-feed">
						{
							ledger.map(([field, instrument, question, surface]) => (
								<article>
									<div>
										<strong>{field}</strong>
										<em>{instrument}</em>
									</div>
									<p>{question}</p>
									<small>{surface}</small>
								</article>
							))
						}
					</div>
				</div>
			</article>

			<article class="feed-entry">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta">
						<span>{c.logLabel}</span>
						<a href={researchHref}>{c.logCta}</a>
					</div>
					<h2>{c.logTitle}</h2>
					<div class="note-feed">
						{
							posts.map((post) => (
								<a href={`${researchHref}/${post.data.urlSlug}`} class="note-row">
									<div>
										<strong>{post.data.title}</strong>
										<span>{fmtDate(post.data.date)} / {post.data.project}</span>
									</div>
									<p>{post.data.description}</p>
								</a>
							))
						}
					</div>
				</div>
			</article>

			<article class="feed-entry feed-entry-plain">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta">
						<span>{c.stanceLabel}</span>
					</div>
					<h2>{c.stanceTitle}</h2>
					<div class="stance-feed">
						{
							stance.map(([title, body]) => (
								<article>
									<strong>{title}</strong>
									<p>{body}</p>
								</article>
							))
						}
					</div>
				</div>
			</article>
		</section>

		<footer class="index-footer">
			<p>
				{c.footerMade} <a class="footer-link" href="https://shiara.design" target="_blank" rel="noreferrer">Shiara Arauzo</a> {c.footerAnd} <a class="footer-link" href="https://railly.dev" target="_blank" rel="noreferrer">Railly Hugo</a>
			</p>
			<div>
				<a class="footer-link" href="https://crafterstation.com" target="_blank" rel="noreferrer">{c.footerStation}</a>
				<a class="footer-link" href="https://github.com/crafter-research" target="_blank" rel="noreferrer">GitHub</a>
				<a class="footer-link" href={researchHref}>{c.navLog}</a>
			</div>
		</footer>
	</main>
</Layout>
