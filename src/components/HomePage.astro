---
import { getCollection } from "astro:content";
import { featuredProjects, type ProjectLocale } from "../data/projects";
import {
	chainByLang,
	copyByLang,
	heroPathByLang,
	heroSignalsByLang,
	ledgerByLang,
	stanceByLang,
} from "../i18n/home";
import type { Lang } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const contentLang: ProjectLocale = lang === "es" ? "es" : "en";

const researchHref = contentLang === "es" ? "/es/research" : "/research";

const copy = copyByLang[contentLang];
const heroSignals = heroSignalsByLang[contentLang];
const heroPath = heroPathByLang[contentLang];
const chain = chainByLang[contentLang];
const ledger = ledgerByLang[contentLang];
const stance = stanceByLang[contentLang];

const posts = (await getCollection("research"))
	.filter((post) => post.data.lang === contentLang)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const fmtDate = (d: Date) =>
	d.toLocaleDateString(contentLang === "es" ? "es-PE" : "en-US", {
		day: "numeric",
		month: "short",
		timeZone: "UTC",
		year: "numeric",
	});

const fmtVerifiedDate = (value: string) =>
	new Date(`${value}T00:00:00Z`).toLocaleDateString(
		contentLang === "es" ? "es-PE" : "en-US",
		{
			day: "numeric",
			month: "short",
			timeZone: "UTC",
			year: "numeric",
		},
	);
---

<Layout title={copy.label} description={copy.description} lang={contentLang}>
	<main class="research-index">
		<header class="index-shell">
			<section class="index-hero">
				<p class="section-label">{copy.kicker}</p>
				<h1>{copy.heroTitle}</h1>
				<p>{copy.heroBody}</p>
				<ul class="index-system" aria-label="Research system">
					{heroPath.map((item) => <li>{item}</li>)}
				</ul>
			</section>
		</header>

		<section
			class="research-feed"
			aria-label="Crafter Research operating system"
		>
			<article class="feed-entry feed-entry-featured">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta"><span>{copy.instrumentLabel}</span></div>
					<h2>{copy.instrumentTitle}</h2>
					<p>{copy.instrumentBody}</p>
					<div class="signal-strip">
						{heroSignals.map(([type, title, body]) => (
								<article>
									<span>{type}</span>
									<strong>{title}</strong>
									<p>{body}</p>
								</article>
							))}
					</div>
				</div>
			</article>

			<article class="feed-entry feed-entry-projects">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta"><span>{copy.projectsLabel}</span></div>
					<h2>{copy.projectsTitle}</h2>
					<p>{copy.projectsBody}</p>
					<div class="project-feed">
						{featuredProjects.map((project) => (
							<article class="project-card" id={project.slug}>
								<header class="project-card-header">
									<div>
										<span class={`project-status project-status-${project.maturity}`}>
											{copy.maturity[project.maturity]}
										</span>
										<h3>{project.name}</h3>
									</div>
									<ul class="artifact-list" aria-label={copy.artifactsLabel}>
										{project.artifactTypes.map((artifact) => <li>{artifact}</li>)}
									</ul>
								</header>
								<p class="project-summary">{project.summary[contentLang]}</p>
								<dl class="project-evidence">
									{project.evidence.map((evidence) => (
										<div>
											<dt>{evidence.label[contentLang]}</dt>
											<dd>
												<a href={evidence.sourceUrl} target="_blank" rel="noreferrer">
													{evidence.value[contentLang]}
												</a>
											</dd>
										</div>
									))}
								</dl>
								<div class="project-limitation">
									<strong>{copy.limitationLabel}</strong>
									<p>{project.limitation[contentLang]}</p>
								</div>
								<footer class="project-card-footer">
									<nav aria-label={`${project.name} ${copy.linksLabel}`}>
										{project.links.map((link) => (
											<a href={link.url} target="_blank" rel="noreferrer">
												{link.label[contentLang]} <span aria-hidden="true">↗</span>
											</a>
										))}
									</nav>
									<small>{copy.verifiedLabel} {fmtVerifiedDate(project.verifiedAt)}</small>
								</footer>
							</article>
						))}
					</div>
				</div>
			</article>

			<article class="feed-entry">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta"><span>{copy.chainLabel}</span></div>
					<h2>{copy.chainTitle}</h2>
					<p>{copy.chainBody}</p>
					<ol class="method-list">
						{chain.map(([_index, title, body]) => (
								<li>
									<strong>{title}</strong>
									<p>{body}</p>
								</li>
							))}
					</ol>
				</div>
			</article>

			<article class="feed-entry">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta"><span>{copy.ledgerLabel}</span></div>
					<h2>{copy.ledgerTitle}</h2>
					<p>{copy.ledgerBody}</p>
					<div class="program-feed">
						{ledger.map(([field, instrument, question, surface]) => (
								<article>
									<div>
										<strong>{field}</strong>
										<em>{instrument}</em>
									</div>
									<p>{question}</p>
									<small>{surface}</small>
								</article>
							))}
					</div>
				</div>
			</article>

			<article class="feed-entry">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta">
						<span>{copy.logLabel}</span>
						<a href={researchHref}>{copy.logCta}</a>
					</div>
					<h2>{copy.logTitle}</h2>
					<div class="note-feed">
						{posts.map((post) => (
								<a href={`${researchHref}/${post.data.urlSlug}`} class="note-row">
									<div>
										<strong>{post.data.title}</strong>
										<span>{fmtDate(post.data.date)} / {post.data.project}</span>
									</div>
									<p>{post.data.description}</p>
							</a>
						))}
					</div>
				</div>
			</article>

			<article class="feed-entry feed-entry-plain">
				<div class="feed-node" aria-hidden="true"></div>
				<div class="feed-panel">
					<div class="feed-meta"><span>{copy.stanceLabel}</span></div>
					<h2>{copy.stanceTitle}</h2>
					<div class="stance-feed">
						{stance.map(([title, body]) => (
								<article>
									<strong>{title}</strong>
									<p>{body}</p>
								</article>
							))}
					</div>
				</div>
			</article>
		</section>
	</main>
</Layout>
